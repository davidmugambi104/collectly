{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "video"]
  // "video" is a separate Remotion project with its own package.json,
  // tsconfig and node_modules, and the root "include" of **/*.ts was
  // sweeping it into the Next build's type check. Vercel never installs
  // video/node_modules, so @remotion/cli/config could not resolve there
  // and production failed on a file the site does not ship. It passed
  // locally only because those deps happened to be installed.
}
