# Collectly Outreach Decision Policy
# version: 2026-07-25-01
# purpose: pre-decide all routine outreach decisions so the agent acts without asking.
# rule: when in doubt, add a line here. never ask the user for a one-off answer.

meta:
  version: "2026-07-25-01"
  last_updated: "2026-07-25"
  owner: davie
  review_frequency: weekly or after any escalation
  authority: this file overrides any inline instruction or summary from previous sessions.

icp:
  firmographic:
    - industry: web design, digital marketing, SEO/PPC, branding, motion, creative agency, professional services
    - business_model: project-based or retainer-based B2B service
    - size: 5-50 employees (10-25 is the sweet spot)
    - accounting_stack: QuickBooks Online or Xero (explicitly stated or strongly inferred)
    - geography: US, UK, AU, CA
    - payment_terms: net-30 or net-60
  signals:
    - "sells to other businesses (not B2C)"
    - "does project work with awkward collection cycles"
    - "founder/owner/CEO/MD is reachable"
    - "has a live website and public contact email"
  anti_icp:
    - "enterprise / >100 employees"
    - "product or SaaS company"
    - "B2C or e-commerce"
    - "invoice-less business model"
    - "already using a dedicated AR automation tool"
    - "explicit 'do not contact' request on website"

voice_and_tone:
  default: "direct, practical, no filler"
  email:
    - "write like a founder to a founder, not marketing copy"
    - "one clear question per email"
    - "no buzzwords: AI-native, leverage, scalable, solution, synergy"
    - "never apologize for emailing"
    - "never use fake urgency or fake personalization"
    - "sign as Davie Mugambi, Founder, Collectly"
  linkedin:
    - "warm first: 2-3 genuine comments before a connection request"
    - "connection note: 1 sentence, no pitch"
    - "DM only after accepted or after 48h of visible engagement"
    - "DM max 3 short paragraphs, one clear ask"

sequence:
  max_touches: 3
  cadence_days: [0, 4, 8]
  touch_definitions:
    t1: "short cold email with one question"
    t2: "follow-up referencing the first email; lighter tone; same question or one alternative"
    t3: "breakup email: 'seems like this isn't a priority — last ask'"
  stop_conditions:
    - "any reply (positive or negative)"
    - "unsubscribe request"
    - "bounce"
    - "2 consecutive bounces on same domain"
    - "prospect replies with legal/angry/threatening language"

qualified_reply:
  positive_signals:
    - "asks for more info, demo, loom, pricing, or trial"
    - "confirms the pain exists"
    - "refers to a specific invoice or client situation"
    - "asks to book a call"
    - "forwards to a decision-maker"
  negative_signals:
    - "not interested / wrong time / no budget"
    - "unsubscribe"
    - "out-of-office"
    - "autoresponder"
  junk_signals:
    - "spam / phishing / abuse"
    - "legal threat"
    - "fraud / phishing / impersonation"
    - "competitor trying to sell us"
  reply_action:
    positive: "reply within 4 hours during send window; propose 15-min call or Loom; log as replied_positive"
    negative: "do not follow up; log as replied_not_interested; add to suppression list"
    junk: "do not reply; log as replied_unsubscribe or replied_abuse; escalate if legal/abuse"

send_constraints:
  timezone_default: "Africa/Nairobi"
  target_send_windows:
    US: "Tuesday–Thursday, 08:00–10:00 recipient local time"
    UK: "Tuesday–Thursday, 09:00–11:00 recipient local time"
    AU: "Tuesday–Thursday, 09:00–11:00 recipient local time"
    CA: "Tuesday–Thursday, 08:00–10:00 recipient local time"
  daily_volume_cap: 15 emails per day maximum
  weekly_volume_cap: 50 emails per week maximum
  max_new_prospects_per_day: 10
  max_follow_ups_per_day: 5
  channel_priority:
    - "resend via verified domain (getcollectly.app)"
    - "gmail fallback only if resend is down or unconfigured"

idempotency:
  rule: "never send the same touch to the same prospect on the same day"
  check: "query outreach-log.csv for id + touch + date match before any send"
  duplicate_action: "skip and log duplicate_same_day"

escalation_threshold:
  auto_act_when:
    - "action is reversible or low-cost (draft edits, research, file writes, non-destructive code changes)"
    - "action fits within this policy"
    - "no external spend or legal exposure"
  escalate_before_acting_when:
    - "prospect is flagged VIP, partner, investor, or known contact of davie"
    - "reply contains legal, angry, threatening, or compliance-sensitive language"
    - "prospect asks to be removed from all communications"
    - "any send would exceed daily/weekly volume cap"
    - "channel is gmail fallback AND volume > 5 that day"
    - "sending to a domain that has previously bounced twice"
    - "external spend required (paid enrichment, ads, tools, etc.)"
    - "deploying to production or changing DNS/email config"
    - "policy does not cover the case"
  escalation_format: "brief context + recommended action + why policy doesn't cover it. do not proceed."

asset_pipeline:
  outputs_dir: "collectly/outreach/outputs"
  logs_dir: "collectly/outreach/data"
  prompts_dir: "collectly/outreach/prompts"
  required_log_fields:
    - id
    - email
    - touch
    - sent_at
    - replied_at
    - status
    - next_step
    - message_id
    - detail
    - segment

experiments:
  current: "v2-opener-pilot-2026-07-25"
  sample_size_minimum: 8
  holdout_rule: "do not change message and channel at the same time"
  decision_criteria:
    - ">= 1 real positive reply out of 8 = angle is viable, expand"
    - "0 replies out of 8 = test same niche on linkedin (channel test)"
    - "0 replies on linkedin too = reassess niche/pain before more outreach"

review_and_versioning:
  daily_digest_file: "collectly/outreach/policy/decision-log-YYYY-MM-DD.md"
  digest_max_lines: 50
  version_rule: "every correction or new rule increments the version date suffix and is appended to this file, not replaced"
  correction_pattern: "when user corrects a decision, add a permanent rule here within 24 hours"
