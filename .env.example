# Collectly — Environment Variables

## Core
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Collectly"

## Database (Postgres)
DATABASE_URL="postgresql://user:pass@localhost:5432/collectly"

## Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
## Signing secret for the Clerk dashboard webhook -> /api/webhooks/clerk
## (Clerk dashboard: Webhooks -> your endpoint -> Signing Secret)
CLERK_WEBHOOK_SECRET=""

## Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
## Stripe Connect (platform OAuth, separate app)
STRIPE_CONNECT_CLIENT_ID=""
STRIPE_CONNECT_REDIRECT_URI="http://localhost:3000/api/stripe-connect/callback"

## Square
SQUARE_CLIENT_ID=""
SQUARE_CLIENT_SECRET=""
SQUARE_REDIRECT_URI="http://localhost:3000/api/square/callback"
SQUARE_ENVIRONMENT="sandbox"   # sandbox | production

## Plaid
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"   # sandbox | development | production
PLAID_WEBHOOK_URL=""

## QuickBooks Online
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_REDIRECT_URI="http://localhost:3000/api/quickbooks/callback"
QBO_ENVIRONMENT="sandbox"

## Xero
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
XERO_REDIRECT_URI="http://localhost:3000/api/xero/callback"

## Twilio (SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

## Email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="hello@getcollectly.app"

## AI
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

## Rate limiting / KV (Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

## Analytics
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
POSTHOG_PROJECT_API_KEY=""

## Cron / Scheduler
CRON_SECRET=""

## App
NODE_ENV="development"
