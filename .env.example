# Collectly — Environment Variables

## Core
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Collectly"

## Search engine webmaster verification (for live deploy)
## Google Search Console: https://search.google.com/search-console/
NEXT_PUBLIC_GSC_TOKEN=""
## Bing Webmaster Tools: https://www.bing.com/webmasters
NEXT_PUBLIC_BING_TOKEN=""

## Database (Postgres)
DATABASE_URL="postgresql://user:pass@localhost:5432/collectly"

## Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
## Signing secret for the Clerk dashboard webhook -> /api/webhooks/clerk
## (Clerk dashboard: Webhooks -> your endpoint -> Signing Secret)
CLERK_WEBHOOK_SECRET=""

## Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
## Stripe Connect (platform OAuth, separate app)
STRIPE_CONNECT_CLIENT_ID=""
STRIPE_CONNECT_REDIRECT_URI="http://localhost:3000/api/stripe-connect/callback"

## Paystack (src/app/api/paystack/*) — secret key only, no client-side key
## is read by the app currently.
PAYSTACK_SECRET_KEY=""

## Square
SQUARE_CLIENT_ID=""
SQUARE_CLIENT_SECRET=""
SQUARE_REDIRECT_URI="http://localhost:3000/api/square/callback"
SQUARE_ENVIRONMENT="sandbox"   # sandbox | production

## Plaid
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"   # sandbox | development | production
PLAID_WEBHOOK_URL=""

## QuickBooks Online
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_REDIRECT_URI="http://localhost:3000/api/quickbooks/callback"
QBO_ENVIRONMENT="sandbox"

## Xero
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
XERO_REDIRECT_URI="http://localhost:3000/api/xero/callback"

## Twilio (SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

## Email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="hello@getcollectly.app"
# Svix signing secret for Resend's outreach-prospect inbound webhook
# (src/lib/outreach-inbound.ts — dashboard > Webhooks). Not used for AR
# dunning replies; those go through Zoho IMAP polling below.
RESEND_INBOUND_WEBHOOK_SECRET=""
RESEND_DELIVERY_WEBHOOK_SECRET=""
# Physical postal address required by CAN-SPAM in every commercial/cold
# email (outreach/scripts/daily_send.py reads this and will refuse to send
# real cold-outreach batches if it's empty). Read into the t1-cold*.md
# footer via {{sender_address}}. Not used by transactional/dunning email.
SENDER_PHYSICAL_ADDRESS=""

## Cold-outreach reply ingestion via Zoho IMAP (src/lib/outreach-imap-poll.ts)
# The mailbox you actually send cold outreach from (e.g. davie@getcollectly.app).
# Polled every ~10 min by /api/cron/outreach-poll to classify replies into
# outreach_contacts/outreach_replies. Generate an app-specific password at
# accounts.zoho.com > Security > App Passwords — do not use the real
# account password.
ZOHO_IMAP_USER=""
ZOHO_IMAP_APP_PASSWORD=""
# ZOHO_IMAP_HOST="imap.zoho.com"
# ZOHO_IMAP_MAILBOX="INBOX"

## AR Inbox — dunning-reply ingestion via Zoho (see src/lib/inbox-imap-poll.ts)
# DORMANT until set: a SEPARATE mailbox from ZOHO_IMAP_USER above — do not
# reuse the outreach address, see the comment in src/lib/infra.ts
# (getDunningReplyToAddress) for why. Leave unset until a dedicated
# address for AR-dunning replies exists.
# AR_DUNNING_IMAP_USER=""
# AR_DUNNING_IMAP_APP_PASSWORD=""
# AR_DUNNING_IMAP_HOST="imap.zoho.com"
# AR_DUNNING_IMAP_MAILBOX="INBOX"
# ZOHO_IMAP_HOST="imap.zoho.com"
# ZOHO_IMAP_MAILBOX="INBOX"

## AI (Google Gemini — used for dunning message generation and inbox
## reply classification, see src/lib/ai/dunning.ts and src/lib/ai/inbox.ts)
GEMINI_API_KEY=""

## Rate limiting / KV (Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

## Analytics
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
POSTHOG_PROJECT_API_KEY=""

## Cron / Scheduler
CRON_SECRET=""

## App
NODE_ENV="development"
